ARG UBUNTU_VERSION=22.04
FROM ubuntu:${UBUNTU_VERSION} AS build
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
COPY install-deps-linux.sh requirements-linux-apt.txt ./
RUN ./install-deps-linux.sh --source
COPY requirements.txt requirements-linux.txt requirements-linux.lock ./
RUN /usr/bin/python3 -m venv .venv \
    && .venv/bin/python -m pip install --disable-pip-version-check --upgrade pip \
    && .venv/bin/python -m pip install --disable-pip-version-check -r requirements-linux.lock
COPY . .
RUN QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_linux_port.UpdateTests.test_package_validation_detects_tampering_and_extra_files \
    tools.test_linux_port.HookTests.test_real_hook_process_does_not_import_qt \
    tools.test_linux_port.QtTests.test_qt_void_bindings_do_not_consume_none_references -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_linux_port.HookTests.test_native_approval_returns_without_waiting_and_keeps_notice \
    tools.test_linux_port.QtTests.test_native_notice_has_only_navigation_and_mode_persists \
    tools.test_linux_port.HookTests.test_permission_decisions_and_mismatched_response -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_state_audit.StateAuditTests.test_compaction_session_restart_and_permission_do_not_swallow_stop \
    tools.test_state_audit.StateAuditTests.test_terminal_turn_rejects_late_permission_but_new_turn_accepts_it \
    tools.test_linux_port.HookTests.test_completed_or_replaced_turn_does_not_publish_permission -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_linux_port.HookTests.test_auto_review_delegates_without_pet_prompt_in_both_modes \
    tools.test_linux_port.HookTests.test_unconfirmed_or_noninteractive_reviewer_uses_codex \
    tools.test_linux_port.HookTests.test_latest_turn_context_wins_after_large_tool_output -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_linux_port.QtTests.test_visible_pet_reaches_work_area_corners_at_different_sizes \
    tools.test_linux_port.QtTests.test_work_area_change_refits_visible_pet_and_hidden_tail -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_linux_port.DockSettingsTests \
    tools.test_linux_port.GeometryTests.test_tail_targets_fit_all_edges_dock_positions_and_scales \
    tools.test_linux_port.GeometryTests.test_small_work_area_keeps_a_reachable_parent_tail \
    tools.test_linux_port.GeometryTests.test_overlay_dock_reservation_respects_position_and_monitor \
    tools.test_linux_port.QtTests.test_tail_transparent_padding_is_clickable_on_all_four_edges -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_sleep_habits \
    tools.test_linux_port.QtTests.test_habits_dialog_saves_delays_and_preserves_other_settings \
    tools.test_linux_port.QtTests.test_habits_save_error_does_not_claim_success \
    tools.test_linux_port.QtTests.test_global_sleep_waits_for_both_tasks_and_compaction \
    tools.test_linux_port.QtTests.test_sleep_waits_for_initial_observation_and_open_menus -q \
    && QT_QPA_PLATFORM=offscreen .venv/bin/python -m unittest \
    tools.test_linux_port.QtTests.test_pig_color_buttons_reset_only_their_own_group \
    tools.test_linux_port.QtTests.test_task_list_keeps_chat_title_and_updates_status -q \
    && ./build-linux.sh
RUN mkdir /tmp/googlepiggy-package \
    && tar -xzf dist/GooglePiggy-*-linux-x86_64.tar.gz -C /tmp/googlepiggy-package \
    && cd /tmp/googlepiggy-package && ./setup-linux.sh \
    && QT_QPA_PLATFORM=offscreen ./googlepiggy \
    --state-dir /tmp/googlepiggy-build-smoke --no-observe --no-update-check --quit-after 2
FROM scratch AS export
COPY --from=build /app/dist/ /
